# --- Supabase (Dashboard > Project Settings > API) ---
# Every table is hub_-prefixed, so this can be a dedicated project or a
# shared one. See DECISIONS.md #1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
# Optional in local development: without it, emails (including sign-in
# links) are printed to the terminal running `pnpm dev`.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=hub@example.com

# --- Site ---
# Used to build links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Daily reminder email (Vercel Cron sends this as a bearer token) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Platform admin ---
# Comma-separated emails that can open /admin (every business, modules and
# estimated revenue). Leave empty to switch the admin area off.
SUPERADMIN_EMAILS=
